---
---
@import "{{ site.theme }}";

// 1. FAZER O SITE APROVEITAR TODA A TELA (LARGURA TOTAL)
.wrapper {
  max-width: 95% !important; // Ocupa 95% da tela, deixando uma margem elegante nas bordas
  padding-left: 30px !important;
  padding-right: 30px !important;
}

// 2. DEIXAR O CABEÇALHO (MENU) TOTALMENTE FIXO NO TOPO
.site-header {
  position: fixed !important;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9999;
  background-color: #ffffff !important; // Garante fundo branco para não misturar com o texto de trás
  border-bottom: 1px solid #e8e8e8;
}

// 3. COMPENSAR O ESPAÇO DO CABEÇALHO FIXO
// Como o menu agora está "flutuando" fixo no topo, precisamos empurrar o conteúdo das páginas para baixo
body {
  padding-top: 80px !important;
}

// 4. CONFIGURAÇÃO DA LOGO NO CABEÇALHO
.header-logo {
  height: 40px; // Altura ideal para a barra de navegação
  vertical-align: middle;
  margin-right: 12px;
  margin-top: -5px;
}
